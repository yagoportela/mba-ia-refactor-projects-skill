# Copie para .env e ajuste. Nunca versione o .env real.
NODE_ENV=development
PORT=3000
DATABASE_PATH=:memory:
# Deixe vazio para desabilitar auth admin em desenvolvimento.
# Em produção, defina um token forte e envie X-Admin-Token nas rotas admin.
ADMIN_TOKEN=
# Usada apenas se um gateway real for integrado. Nunca logue este valor.
PAYMENT_GATEWAY_KEY=
