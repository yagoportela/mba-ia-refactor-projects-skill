# Copie para .env e ajuste os valores. Nunca versione o .env real.
SECRET_KEY=troque-por-uma-chave-aleatoria-forte
DATABASE_PATH=loja.db
DEBUG=false
HOST=127.0.0.1
PORT=5000
# Origens permitidas para CORS, separadas por vírgula. Vazio = sem CORS.
CORS_ORIGINS=http://localhost:3000
# Necessário para habilitar POST /admin/reset-db.
ADMIN_TOKEN=troque-por-um-token-administrativo
