# Copie para .env e ajuste. Nunca versione o .env real.
SECRET_KEY=troque-por-uma-chave-aleatoria-forte
DATABASE_URL=sqlite:///tasks.db
DEBUG=false
HOST=127.0.0.1
PORT=5000
# true exige Authorization: Bearer <token> em todas as rotas exceto /, /health e /login.
AUTH_REQUIRED=false
CORS_ORIGINS=http://localhost:3000

# SMTP opcional. Se vazio, o NotificationService apenas registra em log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
